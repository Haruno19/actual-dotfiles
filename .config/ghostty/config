theme = warm

bold-is-bright = true

window-height = 18
window-width = 78

macos-titlebar-style = tabs
macos-window-buttons = visible

window-title-font-family = Osaka-Mono

font-family = Osaka-Mono
font-family-italic = Space Mono Italic
font-size = 13

keybind = ctrl+opt+enter=ignore

background-blur = false
background-opacity = 1
background-blur-radius = 40

keybind = shift+enter=text:\n

shell-integration-features = sudo
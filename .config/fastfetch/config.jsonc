{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "/Users/haru/.config/fastfetch/whimsicott.png",
    // "type": "kitty-direct",
    // "width": 22,

    // "padding": {
    //     "top": 1,
    //     "left": 3
    // }
    "type": "file",
    "source": "/Users/haru/.config/fastfetch/lantern.txt",
    "color": {
      "1": "38;2;224;86;59",
      "2": "38;2;239;106;79",
      "3": "38;2;51;55;63",
      "4": "38;2;63;69;80",
      "5": "38;2;139;145;156",
      "6": "38;2;91;102;120",
      "7": "38;2;196;204;218"
    },
    "padding": { "top": 1, "left": 2, "right": 6 }
  },
  "modules": [
    "break",
    "break",
    // {
    //   "type": "custom",
    //   "format": "               おかえり❣︎",
    //   "outputColor": "red"
    // },
    {
      "type": "custom",
      "outputColor": "default",
      "format": "┌───────────────────────────────────────┐"
    },
    "break",
    {
      "type": "users",
      "key": "   ",
      "format": "{name} @ Navi",
      "keyColor": "red"
    },
    {
      "type": "host",
      "key": "   ",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "os",
      "key": "   ",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "   ",
      "format": "{1}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "   ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "custom",
      "format": "└───────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "symbol": "square",
      "paddingLeft": 12
    }
  ]
}

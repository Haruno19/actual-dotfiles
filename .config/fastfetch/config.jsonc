{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/Users/haru/.config/fastfetch/apple_s.png",
    "type": "kitty-direct",
    "width": 10,
    "padding": {
      "left": 2
    }
  },
  "modules": [
    {
      "type": "users",
      "key": "who",
      "format": "{name}",
      "keyColor": "yellow"
    },
    {
      "type": "host",
      "key": "host",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{3}",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{1}",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "yellow"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}

#!/usr/bin/env bash
R=$'\e[38;2;224;86;59m'
RH=$'\e[38;2;239;106;79m'
D=$'\e[38;2;51;55;63m'
K=$'\e[38;2;63;69;80m'
S=$'\e[38;2;139;145;156m'
T=$'\e[38;2;196;204;218m'
DIM=$'\e[38;2;91;102;120m'
G=$'\e[38;2;91;191;115m'
X=$'\e[0m'

clock=$(date +%H:%M)
day=$(LC_TIME=C date "+%A · %e %b" | tr -s ' ')

# Uptime via kern.boottime
boot=$(sysctl -n kern.boottime | awk -F'[={,]' '{print $3}' | tr -d ' ')
up=$(( $(date +%s) - boot ))
ud=$((up/86400)); uh=$(((up%86400)/3600)); um=$(((up%3600)/60))
if [ "$ud" -gt 0 ]; then upt="${ud}d ${uh}h"; else upt="${uh}h ${um}m"; fi

# CPU usage — two samples from top, take the second
cpu_idle=$(top -l 2 -n 0 | grep "CPU usage" | tail -1 | awk '{print $(NF-1)}' | tr -d '%')
cpu=$(awk "BEGIN{printf \"%d\", 100 - $cpu_idle}")

# GPU utilization — Apple Silicon integrated GPU via ioreg (no sudo needed)
gpu="--"
gutil=$(ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null \
    | grep -oE '"Device Utilization %"=[0-9]+' | head -1 | grep -oE '[0-9]+$')
[ -n "$gutil" ] && gpu="$gutil"

# Memory via vm_stat + sysctl
page_size=$(sysctl -n hw.pagesize)
total_mem=$(sysctl -n hw.memsize)
vm=$(vm_stat)
pages_free=$(echo "$vm"     | awk '/Pages free/        {gsub(/\./,""); print $3}')
pages_inactive=$(echo "$vm" | awk '/Pages inactive/    {gsub(/\./,""); print $3}')
pages_spec=$(echo "$vm"     | awk '/Pages speculative/ {gsub(/\./,""); print $3}')
avail_mem=$(( (pages_free + pages_inactive + pages_spec) * page_size ))
used_mem=$(( total_mem - avail_mem ))
rused=$(awk "BEGIN{printf \"%.1f\", $used_mem/1073741824}")
rtot=$(awk "BEGIN{printf \"%.0f\", $total_mem/1073741824}")
rpct=$(( 100 * used_mem / total_mem ))

# Disk via df -k (macOS doesn't have -BG or --output)
read -r total_k used_k avail_k < <(df -k / | tail -1 | awk '{print $2, $3, $4}')
dpct="$(( 100 * used_k / total_k ))%"
davail=$(( avail_k / 1048576 ))

i3="${R}${clock}${X}"
i4="${DIM}${day} · up ${upt}${X}"
i6="${DIM}cpu  ${G}${cpu}%${X}"
i7="${DIM}gpu  ${G}${gpu}%${X}"
i8="${DIM}ram  ${T}${rused} ${DIM}/ ${rtot} GB · ${T}${rpct}%${X}"
i9="${DIM}disk ${T}${dpct} ${DIM}· ${davail} GB free${X}"

echo
printf '%s\n' "${K}      ╱▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔╲${X}"
printf '%s\n' "${K}   ▗▄████████████████████▄▖${X}"
printf '%s\n' "${D}      ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀${X}        ${i3}"
printf '%s\n' "${R}        ███   ${D}▐▌${R}   ███${X}          ${i4}"
printf '%s\n' "${R}    ▄▄▄▄███▄▄▄▄▄▄▄▄███▄▄▄▄${X}"
printf '%s\n' "${RH}    ▀▀▀▀███▀▀▀▀▀▀▀▀███▀▀▀▀${X}      ${i6}"
printf '%s\n' "${R}        ███        ███${X}          ${i7}"
printf '%s\n' "${R}        ███        ███${X}          ${i8}"
printf '%s\n' "${R}        ███        ███${X}          ${i9}"
printf '%s\n' "${R}        ███        ███${X}"
printf '%s\n' "${S}       ▟███▙      ▟███▙${X}"
echo

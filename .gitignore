# macOS
**/.DS_Store
.CFUserTextEncoding

# Claude Code runtime data
.claude/
.claude.json
.claude.json.backup

# VS Code — keep settings.json and keybindings.json, ignore the rest
.vscode/extensions/
.vscode/cli/
.vscode/argv.json

# Oh My Zsh installation
.oh-my-zsh/

# .NET runtime caches
.aspnet/
.dotnet/
.nuget/
.templateengine/

# ML model caches
.EasyOCR/
.keras/

# Swift package manager
.swiftpm/

# npm cache
.npm/

# Zsh completion dumps
.zcompdump*

# SSH — track config only, never keys or known_hosts
.ssh/id_*
.ssh/known_hosts*

# App data/logs (not config)
.config/mole/*.log
.config/mole/operations.log
.config/mole/purge_paths
.config/qBittorrent/qBittorrent-data.ini
.config/cagent/
